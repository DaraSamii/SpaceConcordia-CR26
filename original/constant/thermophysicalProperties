FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      thermophysicalProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

thermoType
{
    type            hePsiThermo;
    mixture         pureMixture;
    transport       const;
    thermo          hConst;
    equationOfState perfectGas;
    specie          specie;
    energy          sensibleEnthalpy;//InternalEnergy;//Enthalpy;          //
}

mixture
{
    specie
    {
        molWeight   28.9;
    }
    thermodynamics
    {
        //Cv          712;
        Cp         1005;
        Hf          0;
    }
    transport
    {
        mu          1.82e-05;
        As          1.4792e-06;
        Ts          116;
        Pr          0.7;
    }
}



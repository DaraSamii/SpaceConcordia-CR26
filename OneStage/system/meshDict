#include "../parameters.cs"

surfaceFile "constant/triSurface/combined.stl";
//surfaceFile "geometry/combined.stl";


mu #calc "asin(1.0/$Ma)";
A #calc "4 * tan($mu)";
Pend #calc "$yMax / tan($mu)";
Rocket_L 3.5;

#message "===========================";
#message " mu is $mu";
#message "===========================";


maxCellSize $maxCellSize;
symmetryPlaneLayerTopology	0;
meshMultipleDomainsAndBaffles	0;
nCellsBetweenLevels	4;
domainDefinition
{
    convertAllPatchesToFaceZones	1;
    detachPointsAtAllInternalPatches	0;
    domainNames	();
    generateMeshInAllDomains	1;
}

